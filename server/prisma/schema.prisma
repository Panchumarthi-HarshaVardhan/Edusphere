// ---------------- Attendance Module ----------------

model AttendanceSession {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  subjectId     String   @map("subject_id")
  sectionId     String   @map("section_id")
  facultyId     String   @map("faculty_id")
  sessionDate   DateTime @default(now()) @map("session_date")
  periodNumber  Int      @default(1) @map("period_number")
  topicCovered  String?  @map("topic_covered")
  isCompleted   Boolean  @default(false) @map("is_completed") // For pending dashboard widget
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section     Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  faculty     User               @relation("FacultyConductedSessions", fields: [facultyId], references: [id], onDelete: Cascade)
  records     AttendanceRecord[]

  @@unique([institutionId, subjectId, sectionId, sessionDate, periodNumber])
  @@index([institutionId])
  @@index([subjectId])
  @@index([sectionId])
  @@index([facultyId])
  @@index([sessionDate])
  @@index([isCompleted])
  @@index([institutionId, sectionId, sessionDate], map: "attendance_session_tenant_section_date_idx")
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String           @id @map("_id") @default(uuid())
  institutionId       String           @map("institution_id")
  attendanceSessionId String           @map("attendance_session_id")
  studentId           String           @map("student_id")
  status              AttendanceStatus @default(PRESENT)
  remarks             String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  institution Institution                   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  session     AttendanceSession             @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student     User                          @relation("StudentAttendanceRecords", fields: [studentId], references: [id], onDelete: Cascade)
  corrections AttendanceCorrectionRequest[]

  @@unique([attendanceSessionId, studentId])
  @@index([institutionId])
  @@index([studentId])
  @@index([attendanceSessionId])
  @@index([status])
  @@index([institutionId, studentId, attendanceSessionId], map: "attendance_record_tenant_student_session_idx")
  @@map("attendance_records")
}

model AttendanceCorrectionRequest {
  id                 String           @id @map("_id") @default(uuid())
  institutionId      String           @map("institution_id")
  attendanceRecordId String           @map("attendance_record_id")
  studentId          String           @map("student_id")
  requestedStatus    AttendanceStatus @map("requested_status")
  reason             String
  status             CorrectionStatus @default(PENDING)
  reviewedById       String?          @map("reviewed_by_id")
  reviewRemarks      String?          @map("review_remarks")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  institution Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  record      AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  student     User             @relation("StudentCorrectionRequests", fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy  User?            @relation("FacultyReviewedCorrections", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([studentId])
  @@index([attendanceRecordId])
  @@index([status])
  @@map("attendance_correction_requests")
}

// ---------------- Marks & Grading Module ----------------

model GradeRule {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  gradeLetter   String   @map("grade_letter") // e.g. "A+", "A", "B", "F"
  gradePoint    Float    @map("grade_point") // e.g. 10.0, 9.0, 8.0, 0.0
  minPercentage Float    @map("min_percentage") // e.g. 90.0, 80.0
  maxPercentage Float    @map("max_percentage") // e.g. 100.0, 89.9
  isPass        Boolean  @default(true) @map("is_pass")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, gradeLetter])
  @@index([institutionId])
  @@map("grade_rules")
}

model Assessment {
  id            String           @id @map("_id") @default(uuid())
  institutionId String           @map("institution_id")
  subjectId     String           @map("subject_id")
  sectionId     String           @map("section_id")
  facultyId     String           @map("faculty_id")
  name          String // e.g. "Midterm Internal Exam 1"
  type          AssessmentType
  maxMarks      Float            @map("max_marks") // e.g. 50
  weightage     Float            @default(1.0) // Relative or percentage weightage
  state         PublicationState @default(DRAFT)
  publishedAt   DateTime?        @map("published_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  institution Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section     Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  faculty     User          @relation("FacultyCreatedAssessments", fields: [facultyId], references: [id], onDelete: Cascade)
  marks       StudentMark[]

  @@index([institutionId])
  @@index([subjectId])
  @@index([sectionId])
  @@index([facultyId])
  @@index([state])
  @@index([institutionId, sectionId, state], map: "assessment_tenant_section_state_idx")
  @@map("assessments")
}

model StudentMark {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  assessmentId  String   @map("assessment_id")
  studentId     String   @map("student_id")
  score         Float? // null if absent/exempt
  gradeLetter   String?  @map("grade_letter")
  isAbsent      Boolean  @default(false) @map("is_absent")
  remarks       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assessment  Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student     User                    @relation("StudentAwardedMarks", fields: [studentId], references: [id], onDelete: Cascade)
  corrections MarkCorrectionRequest[]

  @@unique([assessmentId, studentId])
  @@index([institutionId])
  @@index([studentId])
  @@index([assessmentId])
  @@index([institutionId, studentId, assessmentId], map: "student_mark_tenant_student_assessment_idx")
  @@map("student_marks")
}

model MarkCorrectionRequest {
  id            String           @id @map("_id") @default(uuid())
  institutionId String           @map("institution_id")
  studentMarkId String           @map("student_mark_id")
  studentId     String           @map("student_id")
  claimedScore  Float            @map("claimed_score")
  reason        String
  status        CorrectionStatus @default(PENDING)
  reviewedById  String?          @map("reviewed_by_id")
  reviewRemarks String?          @map("review_remarks")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentMark StudentMark @relation(fields: [studentMarkId], references: [id], onDelete: Cascade)
  student     User        @relation("StudentMarkCorrections", fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("FacultyReviewedMarkCorrections", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([studentId])
  @@index([studentMarkId])
  @@index([status])
  @@map("mark_correction_requests")
}

