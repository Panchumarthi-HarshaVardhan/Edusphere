// ---------------- Doubts, Announcements & Timetable ----------------

model Doubt {
  id              String    @id @map("_id") @default(uuid())
  institutionId   String    @map("institution_id")
  subjectId       String    @map("subject_id")
  studentId       String    @map("student_id")
  facultyId       String?   @map("faculty_id")
  title           String
  content         String
  reply           String?
  codeSnippet     String?   @map("code_snippet")
  codeLanguage    String?   @map("code_language")
  attachments     Json?
  tags            Json?
  isAnonymous     Boolean   @default(false) @map("is_anonymous")
  isPinned        Boolean   @default(false) @map("is_pinned")
  isResolved      Boolean   @default(false) @map("is_resolved")
  upvotesCount    Int       @default(0) @map("upvotes_count")
  acceptedReplyId String?   @map("accepted_reply_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  resolvedAt      DateTime? @map("resolved_at")

  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject       Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student       User         @relation("StudentAskedDoubts", fields: [studentId], references: [id], onDelete: Cascade)
  faculty       User?        @relation("FacultyAnsweredDoubts", fields: [facultyId], references: [id], onDelete: SetNull)
  acceptedReply DoubtReply?  @relation("AcceptedReply", fields: [acceptedReplyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies       DoubtReply[] @relation("DoubtReplies")
  votes         DoubtVote[]

  @@index([institutionId])
  @@index([subjectId])
  @@index([studentId])
  @@index([facultyId])
  @@index([isResolved])
  @@index([isPinned])
  @@map("doubts")
}

model DoubtReply {
  id                String   @id @map("_id") @default(uuid())
  institutionId     String   @map("institution_id")
  doubtId           String   @map("doubt_id")
  authorId          String   @map("author_id")
  content           String
  codeSnippet       String?  @map("code_snippet")
  codeLanguage      String?  @map("code_language")
  isFacultyVerified Boolean  @default(false) @map("is_faculty_verified")
  verifiedById      String?  @map("verified_by_id")
  upvotesCount      Int      @default(0) @map("upvotes_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  doubt             Doubt       @relation("DoubtReplies", fields: [doubtId], references: [id], onDelete: Cascade)
  author            User        @relation("UserDoubtReplies", fields: [authorId], references: [id], onDelete: Cascade)
  verifiedBy        User?       @relation("FacultyVerifiedReplies", fields: [verifiedById], references: [id], onDelete: SetNull)
  votes             DoubtVote[]
  acceptedForDoubts Doubt[]     @relation("AcceptedReply")

  @@index([institutionId])
  @@index([doubtId])
  @@index([authorId])
  @@map("doubt_replies")
}

model DoubtVote {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  userId        String   @map("user_id")
  doubtId       String?  @map("doubt_id")
  replyId       String?  @map("reply_id")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  doubt       Doubt?      @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  reply       DoubtReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, doubtId])
  @@unique([userId, replyId])
  @@index([institutionId])
  @@index([userId])
  @@index([doubtId])
  @@index([replyId])
  @@map("doubt_votes")
}

// ---------------- Community Module ----------------

model CommunityPost {
  id                     String      @id @map("_id") @default(uuid())
  institutionId          String      @map("institution_id")
  authorId               String      @map("author_id")
  scope                  PostScope   @default(INSTITUTION)
  departmentId           String?     @map("department_id")
  academicYearId         String?     @map("academic_year_id")
  sectionId              String?     @map("section_id")
  section                PostSection @default(UNIVERSITY_FEED)
  title                  String?
  content                String
  images                 Json? // Array of image URLs
  documents              Json? // Array of { name: string, url: string, size?: number }
  links                  Json? // Array of string URLs
  hashtags               Json? // Array of string tags e.g. ["#hackathon", "#exam"]
  mentions               Json? // Array of string user mentions
  isVerifiedAnnouncement Boolean     @default(false) @map("is_verified_announcement")
  isPinned               Boolean     @default(false) @map("is_pinned")
  likesCount             Int         @default(0) @map("likes_count")
  commentsCount          Int         @default(0) @map("comments_count")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  institution  Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?   @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  sectionRef   Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  poll         PostPoll?
  likes        PostLike[]
  comments     PostComment[]
  reports      ContentReport[]

  @@index([institutionId])
  @@index([authorId])
  @@index([scope])
  @@index([section])
  @@index([departmentId])
  @@index([academicYearId])
  @@index([sectionId])
  @@index([createdAt])
  @@index([institutionId, isPinned, createdAt], map: "community_post_tenant_pinned_date_idx")
  @@index([institutionId, scope, createdAt], map: "community_post_tenant_scope_date_idx")
  @@map("community_posts")
}

model PostPoll {
  id            String    @id @map("_id") @default(uuid())
  institutionId String    @map("institution_id")
  postId        String    @unique @map("post_id")
  question      String
  options       Json // Array of { id: string, text: string, voteCount: number }
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  institution Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes       PollVote[]

  @@index([institutionId])
  @@map("post_polls")
}

model PollVote {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  pollId        String   @map("poll_id")
  userId        String   @map("user_id")
  optionIndex   Int      @map("option_index")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  poll        PostPoll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([institutionId])
  @@index([pollId])
  @@index([userId])
  @@map("poll_votes")
}

model PostLike {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  postId        String   @map("post_id")
  userId        String   @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([institutionId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  postId        String   @map("post_id")
  authorId      String   @map("author_id")
  content       String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([postId])
  @@index([authorId])
  @@index([postId, createdAt], map: "post_comment_post_date_idx")
  @@map("post_comments")
}

model ContentReport {
  id            String              @id @map("_id") @default(uuid())
  institutionId String              @map("institution_id")
  reporterId    String              @map("reporter_id")
  targetType    ContentReportTarget @map("target_type")
  targetId      String              @map("target_id")
  postId        String?             @map("post_id")
  reason        String
  details       String?
  status        ContentReportStatus @default(PENDING)
  reviewedById  String?             @map("reviewed_by_id")
  reviewedAt    DateTime?           @map("reviewed_at")
  actionNotes   String?             @map("action_notes")
  createdAt     DateTime            @default(now()) @map("created_at")

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  reporter    User           @relation("UserReportedContent", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy  User?          @relation("AdminReviewedReports", fields: [reviewedById], references: [id], onDelete: SetNull)
  post        CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@map("content_reports")
}

model Announcement {
  id            String    @id @map("_id") @default(uuid())
  institutionId String    @map("institution_id")
  authorId      String    @map("author_id")
  title         String
  content       String
  targetRole    RoleType? @map("target_role")
  isPinned      Boolean   @default(false) @map("is_pinned")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  author      User        @relation("AuthorAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([authorId])
  @@index([createdAt])
  @@map("announcements")
}

model TimetableSlot {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  sectionId     String   @map("section_id")
  subjectId     String   @map("subject_id")
  facultyId     String   @map("faculty_id")
  periodId      String?  @map("period_id")
  dayOfWeek     Int      @map("day_of_week") // 1 = Mon, 2 = Tue, ..., 6 = Sat
  periodNumber  Int      @map("period_number")
  startTime     String   @map("start_time") // e.g. "09:00"
  endTime       String   @map("end_time") // e.g. "10:00"
  roomNumber    String?  @map("room_number")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  section     Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty     User                @relation("FacultyTimetableSlots", fields: [facultyId], references: [id], onDelete: Cascade)
  period      Period?             @relation(fields: [periodId], references: [id], onDelete: SetNull)
  overrides   TimetableOverride[]

  @@unique([institutionId, sectionId, dayOfWeek, periodNumber])
  @@index([institutionId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([facultyId])
  @@index([periodId])
  @@map("timetable_slots")
}

model Period {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  number        Int
  name          String
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution    Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  timetableSlots TimetableSlot[]

  @@unique([institutionId, number])
  @@index([institutionId])
  @@map("periods")
}

model AcademicCalendarEvent {
  id            String            @id @map("_id") @default(uuid())
  institutionId String            @map("institution_id")
  sectionId     String?           @map("section_id")
  type          CalendarEventType
  title         String
  description   String?
  startDate     DateTime          @map("start_date")
  endDate       DateTime          @map("end_date")
  createdById   String            @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  section     Section?    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([institutionId, startDate, endDate])
  @@index([sectionId])
  @@map("academic_calendar_events")
}

model TimetableOverride {
  id                  String                @id @map("_id") @default(uuid())
  institutionId       String                @map("institution_id")
  timetableSlotId     String                @map("timetable_slot_id")
  date                DateTime             
  type                TimetableOverrideType
  substituteFacultyId String?               @map("substitute_faculty_id")
  substituteRoom      String?               @map("substitute_room")
  note                String?
  createdById         String                @map("created_by_id")
  createdAt           DateTime              @default(now()) @map("created_at")

  institution       Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  timetableSlot     TimetableSlot @relation(fields: [timetableSlotId], references: [id], onDelete: Cascade)
  substituteFaculty User?         @relation("SubstituteFaculty", fields: [substituteFacultyId], references: [id], onDelete: SetNull)
  createdBy         User          @relation("TimetableOverrideCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([institutionId, timetableSlotId, date])
  @@index([institutionId, date])
  @@index([substituteFacultyId])
  @@map("timetable_overrides")
}
