generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  HOD
  CLASS_INCHARGE
  FACULTY
  STUDENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
}

enum MaterialType {
  PDF
  PPT
  DOCX
  IMAGE
  VIDEO_LINK
  QUESTION_PAPER
  LAB_MANUAL
  SYLLABUS
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssessmentType {
  INTERNAL_1
  INTERNAL_2
  ASSIGNMENT
  LAB
  PRACTICAL
  VIVA
  EXTERNAL
}

enum PublicationState {
  DRAFT
  PUBLISHED
}

enum NotificationCategory {
  ATTENDANCE
  ACADEMIC
  EXAM
  ASSIGNMENT
  COMMUNITY
  ANNOUNCEMENT
  ADMIN
}

enum CalendarEventType {
  HOLIDAY
  EXAM
  EVENT
  ASSESSMENT_WINDOW
}

enum TimetableOverrideType {
  CANCELLED
  SUBSTITUTE
}

enum PostScope {
  INSTITUTION
  DEPARTMENT
  YEAR
  SECTION
  PRIVATE_GROUP
}

enum PostSection {
  UNIVERSITY_FEED
  DEPARTMENT
  YEAR_AND_SECTION
  CLUBS
  EVENTS
  ACHIEVEMENTS
  LOST_AND_FOUND
  PLACEMENTS
}

enum ContentReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum ContentReportTarget {
  POST
  COMMENT
  DOUBT
  DOUBT_REPLY
}

model Institution {
  id                         String   @id @map("_id") @default(uuid())
  name                       String
  code                       String   @unique
  domain                     String?
  logoUrl                    String?  @map("logo_url")
  defaultAttendanceThreshold Float    @default(75.0) @map("default_attendance_threshold")
  isActive                   Boolean  @default(true) @map("is_active")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  // Relationships
  users                   User[]
  departments             Department[]
  programs                Program[]
  academicYears           AcademicYear[]
  semesters               Semester[]
  sections                Section[]
  subjects                Subject[]
  studentEnrollments      StudentEnrollment[]
  facultyAssignments      FacultyAssignment[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  units                   Unit[]
  studyMaterials          StudyMaterial[]
  materialVersions        MaterialVersion[]
  materialViews           MaterialView[]
  materialDownloads       MaterialDownload[]
  materialBookmarks       MaterialBookmark[]
  classroomSessions       ClassroomSession[]
  canvasPages             CanvasPage[]
  canvasAssets            CanvasAsset[]
  attendanceSessions      AttendanceSession[]
  attendanceRecords       AttendanceRecord[]
  attendanceCorrections   AttendanceCorrectionRequest[]
  gradeRules              GradeRule[]
  assessments             Assessment[]
  studentMarks            StudentMark[]
  markCorrections         MarkCorrectionRequest[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  emailJobs               EmailJobQueue[]
  doubts                  Doubt[]
  doubtReplies            DoubtReply[]
  doubtVotes              DoubtVote[]
  announcements           Announcement[]
  timetableSlots          TimetableSlot[]
  periods                 Period[]
  calendarEvents          AcademicCalendarEvent[]
  timetableOverrides      TimetableOverride[]
  communityPosts          CommunityPost[]
  postPolls               PostPoll[]
  pollVotes               PollVote[]
  postLikes               PostLike[]
  postComments            PostComment[]
  contentReports          ContentReport[]
  guardianConsents        GuardianConsent[]
  dataRetentionSettings   InstitutionDataRetention?
  demoRequests            DemoRequest[]

  @@map("institutions")
  @@index([domain])
}

model DemoRequest {
  id                String   @id @map("_id") @default(uuid())
  // Optional until a prospect becomes a registered tenant.
  institutionId     String?  @map("institution_id")
  contactName       String   @map("contact_name")
  institutionName   String   @map("institution_name")
  role              String
  email             String
  message           String
  status            String   @default("NEW")
  createdAt         DateTime @default(now()) @map("created_at")

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([createdAt])
  @@map("demo_requests")
}

model User {
  id                String    @id @map("_id") @default(uuid())
  institutionId     String    @map("institution_id")
  email             String
  passwordHash      String    @map("password_hash")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  role              RoleType  @default(STUDENT)
  mustResetPassword Boolean   @default(true) @map("must_reset_password")
  isActive          Boolean   @default(true) @map("is_active")
  deactivatedAt     DateTime? @map("deactivated_at")
  isMinor           Boolean   @default(false) @map("is_minor")
  isAnonymized      Boolean   @default(false) @map("is_anonymized")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  institution              Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  guardianConsents         GuardianConsent[] @relation("GuardianConsentSubject")
  recordedGuardianConsents GuardianConsent[] @relation("GuardianConsentRecorder")

  // Role-specific relations
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  enrollments                   StudentEnrollment[]
  facultyAssignments            FacultyAssignment[]
  createdMaterials              StudyMaterial[]               @relation("FacultyCreatedMaterials")
  materialViews                 MaterialView[]
  materialDownloads             MaterialDownload[]
  materialBookmarks             MaterialBookmark[]
  classroomSessions             ClassroomSession[]            @relation("FacultyClassroomSessions")
  conductedAttendanceSessions   AttendanceSession[]           @relation("FacultyConductedSessions")
  attendanceRecords             AttendanceRecord[]            @relation("StudentAttendanceRecords")
  correctionRequests            AttendanceCorrectionRequest[] @relation("StudentCorrectionRequests")
  reviewedCorrections           AttendanceCorrectionRequest[] @relation("FacultyReviewedCorrections")
  createdAssessments            Assessment[]                  @relation("FacultyCreatedAssessments")
  studentMarks                  StudentMark[]                 @relation("StudentAwardedMarks")
  markCorrectionRequests        MarkCorrectionRequest[]       @relation("StudentMarkCorrections")
  reviewedMarkCorrections       MarkCorrectionRequest[]       @relation("FacultyReviewedMarkCorrections")
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  askedDoubts                   Doubt[]                       @relation("StudentAskedDoubts")
  answeredDoubts                Doubt[]                       @relation("FacultyAnsweredDoubts")
  doubtReplies                  DoubtReply[]                  @relation("UserDoubtReplies")
  verifiedDoubtReplies          DoubtReply[]                  @relation("FacultyVerifiedReplies")
  doubtVotes                    DoubtVote[]
  authoredAnnouncements         Announcement[]                @relation("AuthorAnnouncements")
  facultyTimetableSlots         TimetableSlot[]               @relation("FacultyTimetableSlots")
  substitutedTimetableOverrides TimetableOverride[]           @relation("SubstituteFaculty")
  createdCalendarEvents         AcademicCalendarEvent[]       @relation("CalendarEventCreator")
  createdTimetableOverrides     TimetableOverride[]           @relation("TimetableOverrideCreator")
  communityPosts                CommunityPost[]
  postLikes                     PostLike[]
  postComments                  PostComment[]
  pollVotes                     PollVote[]
  contentReports                ContentReport[]               @relation("UserReportedContent")
  reviewedReports               ContentReport[]               @relation("AdminReviewedReports")

  @@unique([institutionId, email])
  @@index([institutionId])
  @@index([role])
  @@index([institutionId, isActive, deactivatedAt])
  @@map("users")
}

model RefreshToken {
  id                  String    @id @map("_id") @default(uuid())
  institutionId       String    @map("institution_id")
  userId              String    @map("user_id")
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Department {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  name          String
  code          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution    Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programs       Program[]
  users          User[]
  communityPosts CommunityPost[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("departments")
}

model Program {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  departmentId  String   @map("department_id")
  name          String
  code          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesters   Semester[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([departmentId])
  @@map("programs")
}

model AcademicYear {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  name          String // e.g. "2025-2026"
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  isCurrent     Boolean  @default(false) @map("is_current")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution    Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  semesters      Semester[]
  communityPosts CommunityPost[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("academic_years")
}

model Semester {
  id             String   @id @map("_id") @default(uuid())
  institutionId  String   @map("institution_id")
  academicYearId String   @map("academic_year_id")
  programId      String   @map("program_id")
  semesterNumber Int      @map("semester_number") // e.g. 1, 2, 3
  name           String // e.g. "Semester 1"
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  program      Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  sections     Section[]
  subjects     Subject[]

  @@unique([institutionId, programId, academicYearId, semesterNumber])
  @@index([institutionId])
  @@index([academicYearId])
  @@index([programId])
  @@map("semesters")
}

model Section {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  semesterId    String   @map("semester_id")
  name          String // e.g. "Section A", "Section B"
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution        Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  semester           Semester                @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  enrollments        StudentEnrollment[]
  facultyAssignments FacultyAssignment[]
  targetMaterials    MaterialTargetSection[]
  classroomSessions  ClassroomSession[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  timetableSlots     TimetableSlot[]
  calendarEvents     AcademicCalendarEvent[]
  communityPosts     CommunityPost[]

  @@unique([institutionId, semesterId, name])
  @@index([institutionId])
  @@index([semesterId])
  @@map("sections")
}

model Subject {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  semesterId    String   @map("semester_id")
  name          String
  code          String
  credits       Float    @default(3.0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  semester           Semester            @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  facultyAssignments FacultyAssignment[]
  units              Unit[]
  materials          StudyMaterial[]
  classroomSessions  ClassroomSession[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  doubts             Doubt[]
  timetableSlots     TimetableSlot[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([semesterId])
  @@map("subjects")
}

model StudentEnrollment {
  id            String           @id @map("_id") @default(uuid())
  institutionId String           @map("institution_id")
  studentId     String           @map("student_id")
  sectionId     String           @map("section_id")
  rollNumber    String           @map("roll_number")
  status        EnrollmentStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section     Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, sectionId, studentId])
  @@unique([institutionId, rollNumber])
  @@index([institutionId])
  @@index([studentId])
  @@index([sectionId])
  @@map("student_enrollments")
}

model FacultyAssignment {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  facultyId     String   @map("faculty_id")
  subjectId     String   @map("subject_id")
  sectionId     String   @map("section_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  faculty     User        @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section     Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, facultyId, subjectId, sectionId])
  @@index([institutionId])
  @@index([facultyId])
  @@index([subjectId])
  @@index([sectionId])
  @@map("faculty_assignments")
}

// ---------------- Study Materials & Units ----------------

model Unit {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  subjectId     String   @map("subject_id")
  unitNumber    Int      @map("unit_number")
  title         String
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject     Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  materials   StudyMaterial[]

  @@unique([institutionId, subjectId, unitNumber])
  @@index([institutionId])
  @@index([subjectId])
  @@map("units")
}

model StudyMaterial {
  id             String       @id @map("_id") @default(uuid())
  institutionId  String       @map("institution_id")
  subjectId      String       @map("subject_id")
  unitId         String?      @map("unit_id")
  createdById    String       @map("created_by_id")
  title          String
  description    String?
  type           MaterialType
  externalUrl    String?      @map("external_url") // For VIDEO_LINK or external resources
  visibleFrom    DateTime     @default(now()) @map("visible_from")
  allowDownload  Boolean      @default(true) @map("allow_download")
  currentVersion Int          @default(1) @map("current_version")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit        Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdBy   User        @relation("FacultyCreatedMaterials", fields: [createdById], references: [id], onDelete: Cascade)

  versions       MaterialVersion[]
  targetSections MaterialTargetSection[]
  views          MaterialView[]
  downloads      MaterialDownload[]
  bookmarks      MaterialBookmark[]

  @@index([institutionId])
  @@index([subjectId])
  @@index([unitId])
  @@index([createdById])
  @@index([visibleFrom])
  @@map("study_materials")
}

model MaterialVersion {
  id               String   @id @map("_id") @default(uuid())
  institutionId    String   @map("institution_id")
  studyMaterialId  String   @map("study_material_id")
  versionNumber    Int      @map("version_number")
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  fileSizeBytes    Int      @map("file_size_bytes")
  s3Key            String   @map("s3_key")
  convertedS3Key   String?  @map("converted_s3_key") // PDF version for PPT/DOCX inline preview
  isConverted      Boolean  @default(false) @map("is_converted")
  changeNote       String?  @map("change_note")
  createdAt        DateTime @default(now()) @map("created_at")

  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studyMaterial StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)

  @@unique([studyMaterialId, versionNumber])
  @@index([institutionId])
  @@index([studyMaterialId])
  @@map("material_versions")
}

model MaterialTargetSection {
  id              String @id @map("_id") @default(uuid())
  studyMaterialId String @map("study_material_id")
  sectionId       String @map("section_id")

  studyMaterial StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  section       Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studyMaterialId, sectionId])
  @@index([studyMaterialId])
  @@index([sectionId])
  @@map("material_target_sections")
}

model MaterialView {
  id              String   @id @map("_id") @default(uuid())
  institutionId   String   @map("institution_id")
  studyMaterialId String   @map("study_material_id")
  userId          String   @map("user_id")
  viewedAt        DateTime @default(now()) @map("viewed_at")

  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studyMaterial StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([studyMaterialId])
  @@index([userId])
  @@index([viewedAt])
  @@map("material_views")
}

model MaterialDownload {
  id              String   @id @map("_id") @default(uuid())
  institutionId   String   @map("institution_id")
  studyMaterialId String   @map("study_material_id")
  userId          String   @map("user_id")
  downloadedAt    DateTime @default(now()) @map("downloaded_at")

  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studyMaterial StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([studyMaterialId])
  @@index([userId])
  @@index([downloadedAt])
  @@map("material_downloads")
}

model MaterialBookmark {
  id              String   @id @map("_id") @default(uuid())
  institutionId   String   @map("institution_id")
  studyMaterialId String   @map("study_material_id")
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studyMaterial StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studyMaterialId, userId])
  @@index([institutionId])
  @@index([userId])
  @@map("material_bookmarks")
}

model AuditLog {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  userId        String?  @map("user_id")
  action        String // e.g. "AUTH_LOGIN", "PASSWORD_CHANGE", "UPDATE_MARKS"
  resource      String // e.g. "user", "marks", "attendance"
  resourceId    String?  @map("resource_id")
  details       Json? // Before/after state or metadata
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model GuardianConsent {
  id               String    @id @map("_id") @default(uuid())
  institutionId    String    @map("institution_id")
  userId           String    @map("user_id")
  recordedByUserId String?   @map("recorded_by_user_id")
  guardianName     String    @map("guardian_name")
  guardianEmail    String?   @map("guardian_email")
  relationship     String
  consentMethod    String    @map("consent_method")
  policyVersion    String    @map("policy_version")
  consentGivenAt   DateTime  @default(now()) @map("consent_given_at")
  revokedAt        DateTime? @map("revoked_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation("GuardianConsentSubject", fields: [userId], references: [id], onDelete: Cascade)
  recorder    User?       @relation("GuardianConsentRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([institutionId, userId, revokedAt])
  @@map("guardian_consents")
}

model InstitutionDataRetention {
  id                           String   @id @map("_id") @default(uuid())
  institutionId                String   @unique @map("institution_id")
  inactiveAccountRetentionDays Int?     @map("inactive_account_retention_days")
  auditLogRetentionDays        Int?     @map("audit_log_retention_days")
  preserveAcademicRecords      Boolean  @default(true) @map("preserve_academic_records")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@map("institution_data_retention")
}

// ---------------- Digital Classroom Canvas ----------------

model ClassroomSession {
  id            String   @id @map("_id") @default(uuid())
  institutionId String   @map("institution_id")
  subjectId     String   @map("subject_id")
  sectionId     String   @map("section_id")
  facultyId     String   @map("faculty_id")
  title         String
  sessionDate   DateTime @default(now()) @map("session_date")
  allowDownload Boolean  @default(true) @map("allow_download")
  isArchived    Boolean  @default(false) @map("is_archived")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  faculty     User         @relation("FacultyClassroomSessions", fields: [facultyId], references: [id], onDelete: Cascade)
  pages       CanvasPage[]
  assets      CanvasAsset[]

  @@index([institutionId])
  @@index([subjectId])
  @@index([sectionId])
  @@index([facultyId])
  @@index([sessionDate])
  @@map("classroom_sessions")
}

model CanvasAsset {
  id                 String   @id @map("_id") @default(uuid())
  institutionId      String   @map("institution_id")
  classroomSessionId String   @map("classroom_session_id")
  s3Key              String   @map("s3_key")
  originalFilename   String   @map("original_filename")
  mimeType           String   @map("mime_type")
