# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
DATABASE_URL="mongodb://127.0.0.1:27018/edusphere?replicaSet=rs0"

# JWT Authentication
# Set independent random values of at least 32 characters outside development.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS
CLIENT_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"
TRUST_PROXY=false

# Email delivery: dev/test defaults to log-only; production defaults to SMTP.
EMAIL_MODE=log
# EMAIL_PROVIDER=smtp | resend | sendgrid
EMAIL_PROVIDER=smtp
EMAIL_FROM="EduSphere <notifications@example.com>"
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# For Resend or SendGrid SMTP, set EMAIL_PROVIDER and EMAIL_API_KEY.
EMAIL_API_KEY=

# Optional S3-compatible object storage (local uploads are used when unset).
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
