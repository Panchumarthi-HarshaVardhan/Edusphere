{
  "name": "edusphere-server",
  "version": "1.0.0",
  "description": "EduSphere Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "vercel-build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "../client/node_modules/.bin/oxlint src test prisma scripts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "pretest": "node --import tsx test/prepare-test-database.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "node --import tsx --test src/services/*.test.ts src/middleware/*.test.ts src/utils/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:deploy": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "privacy:retention": "tsx scripts/run-retention.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@prisma/client": "^5.22.0",
    "@types/pdfmake": "^0.3.3",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "pdfmake": "^0.3.11",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
